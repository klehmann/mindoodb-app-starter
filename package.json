{
  "name": "mindoodb-app-starter",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Starter template for a MindooDB Haven application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4300",
    "dev:local": "LOCAL_MINDOODB=1 vite --port 4300",
    "build": "vue-tsc --noEmit && vite build",
    "build:local": "LOCAL_MINDOODB=1 vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev --port 4300",
    "preview:local": "pnpm run build:local && wrangler dev --port 4300",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mindoodb-app-sdk": "^0.0.47",
    "vue": "^3.5.31"
  },
  "devDependencies": {
    "@automerge/automerge": "^3.2.1",
    "@types/node": "25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.81.0"
  }
}
